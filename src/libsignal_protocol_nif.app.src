{application,
 libsignal_protocol_nif,
 [{description,
   "High-performance Erlang NIF implementing Signal Protocol cryptographic primitives with libsodium. Provides Curve25519, Ed25519, AES-GCM, SHA-256/512, and HMAC-SHA256 operations."},
  {vsn, "0.3.0"},
  {registered, []},
  {applications, [kernel, stdlib]},
  {env, []},
  {modules, []},
  {licenses, ["Apache-2.0"]},
  {links, [{"GitHub", "https://github.com/DROOdotFOO/libsignal-protocol-nif"}]},
  {build_tools, ["rebar3"]},
  {files,
   ["src/*.erl",
    "src/*.app.src",
    "c_src/*.c",
    "c_src/*.h",
    "c_src/CMakeLists.txt",
    "c_src/build_nif.sh",
    "VERSION",
    "rebar.config",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"]}]}.
